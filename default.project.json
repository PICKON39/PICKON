{
  "name": "Abandoned",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false,
        "CameraMaxZoomDistance": 22
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "Health": {
          "$path": "src/character/Health.server.luau"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true,
        "RespawnTime": 3
      }
    }
  }
}
